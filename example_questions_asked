Question: Which teacher is the most successful so far?

SQL: WITH graded AS (
    SELECT ct.teacher_id,
           CASE UPPER(TRIM(cs.grade))
               WHEN 'A+' THEN 4.0 WHEN 'A'  THEN 4.0 WHEN 'A-' THEN 3.7
               WHEN 'B+' THEN 3.3 WHEN 'B'  THEN 3.0 WHEN 'B-' THEN 2.7
               WHEN 'C+' THEN 2.3 WHEN 'C'  THEN 2.0 WHEN 'C-' THEN 1.7
               WHEN 'D+' THEN 1.3 WHEN 'D'  THEN 1.0 WHEN 'D-' THEN 0.7
               WHEN 'F'  THEN 0.0
           END AS grade_points
    FROM course_teacher ct
    JOIN course_student cs ON cs.course_id = ct.course_id       
    WHERE cs.grade IS NOT NULL
),
teacher_stats AS (
    SELECT teacher_id,
           ROUND(AVG(grade_points), 2) AS avg_gpa,
           COUNT(grade_points) AS graded_enrollments
    FROM graded
    WHERE grade_points IS NOT NULL
    GROUP BY teacher_id
)
SELECT t.teacher_id, t.full_name, t.subject, ts.avg_gpa, ts.graded_enrollments
FROM teacher_stats ts
JOIN teacher t ON t.teacher_id = ts.teacher_id
WHERE ts.avg_gpa = (SELECT MAX(avg_gpa) FROM teacher_stats)     
ORDER BY ts.graded_enrollments DESC, t.full_name;

Answer: Measured by the average grade their students have earned, Michael Brown (Physical Education) comes out on top with a 3.71 GPA across 7 graded enrollments. Keep in mind this only reflects student grades, which can vary by subject and grading style, and 7 grades is a fairly small sample.
